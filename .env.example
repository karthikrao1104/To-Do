# Server-side environment variable for Vercel / serverless functions
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE

# Optional: Configurable AI model (e.g. google/gemma-4-31b-it:free or any OpenRouter model)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: Comma-separated models attempted after OPENROUTER_MODEL
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free
