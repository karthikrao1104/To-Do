# Multi-Provider Configuration

# 1. OpenRouter (Primary Provider)
# Supports comma-separated keys for round-robin rotation, and/or single key backward compatibility
OPENROUTER_API_KEYS=key1,key2
OPENROUTER_API_KEY=key1

# Optional: Configurable OpenRouter model (e.g. openrouter/free, cohere/north-mini-code:free)
OPENROUTER_MODEL=openrouter/free

# Optional: Comma-separated fallback models
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,liquid/lfm-3-1.7b:free,mistral/mistral-7b-instruct:free

# Set to true only if you explicitly allow paid inference
OPENROUTER_ALLOW_PAID=false

# 2. Google Gemini (Second Priority Fallback)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. Groq (Third Priority Fallback)
# Get your API key from Groq Console (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
